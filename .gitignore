# ==========================================
# Packer Build Output & Binaries
# ==========================================
output-*/
packer_cache/
packer.exe

# ==========================================
# Hyper-V Disks, States & Structure
# ==========================================
Hyper-V_VMs/*
!Hyper-V_VMs/.gitkeep
*.vhdx
*.avhdx
*.vhd
*.vmcx
*.vmrs
*.vmgs
*.vsv
*.bin

# Allow Hyper-V folder tracking via placeholder
!Hyper-V_VMs/.gitkeep

# ==========================================
# ISOs & OS Media Files
# ==========================================
*.iso
*.img

# Allow ISO folder tracking via placeholder
!ISOs/.gitkeep

# ==========================================
# Packer Configuration & Locks
# ==========================================
.pkr.hcl.lock

# ==========================================
# Logs & Temporary Files
# ==========================================
*.log
*.tmp
*.bak
*.old
*.cache

# ==========================================
# Windows Host System Junk
# ==========================================
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk

# ==========================================
# VS Code & Workspace Files
# ==========================================
.vscode/
*.code-workspace